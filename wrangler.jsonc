{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "online-bookstore",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-12",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "w12-rag-db",
			"database_id": "dbd79221-af88-4095-a87b-36a134a146c9",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "w12-rag-vectors",
			"remote": true
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	}
}
